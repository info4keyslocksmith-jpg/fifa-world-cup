# Optional. Leave this file out entirely for normal use.
# HEADLESS=1                    run Chrome invisibly (not recommended for Instagram/TikTok)
# BROWSER_EXECUTABLE=           full path to a specific Chrome/Chromium binary
# CHROME_PROFILE_DIR=           where the logged-in profile lives (default social-agent/.chrome-profile)
# DRIVE_FOLDER=                 full path to the synced "Videos 4keys Claude" folder, only if it isn't found automatically
# DRIVE_FOLDER_NAME=            the folder's name in Drive (default "Videos 4keys Claude")
